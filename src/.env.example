
# Dev : DEBUG=True et ALLOWED_HOSTS=localhost,127.0.0.1 — Prod : DEBUG=False et domaines réels
DEBUG=False
ALLOWED_HOSTS=ctams.net,www.ctams.net

# URL du back-office — choisir une valeur unique et difficile à deviner, sans "admin"
ADMIN_URL=votre-url-secrete-ici/

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CTAMS <contact@ctams.ci>
