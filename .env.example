SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Base de données (SQLite par défaut, MySQL en prod — USE_MYSQL=True)
USE_MYSQL=False
MYSQL_DB=ctams
MYSQL_USER=ctams_user
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=CTAMS <contact@ctams.ci>

# Celery / Redis
REDIS_URL=redis://127.0.0.1:6379
